    "@angular/platform-browser": "22.2.2",
    "@simplewebauthn/server": "14.0.3",
    "dompurify": "3.4.16",
    "driver.js": "1.9.0",
    "electron-updater": "6.8.9",
    "highlight.js": "11.11.1",
    "ical.js": "2.2.1",
    "jose": "6.2.2",
    "katex": "0.19.0",
    "lucide": "1.54.0",
    "marked": "18.1.0",
