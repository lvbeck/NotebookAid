    "test:platform": "node scripts/test-platform.cjs",
    "package:mac": "node scripts/package.cjs --mac",
    "installer:mac": "node scripts/build-macos.cjs",
    "smoke": "node scripts/smoke.cjs",
    "package": "node scripts/package.cjs",
    "installer": "node scripts/build-installer.cjs",
    "installer:msi": "node scripts/build-msi.cjs"
  },
