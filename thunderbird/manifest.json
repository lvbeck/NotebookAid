{
  "manifest_version": 2,
  "name": "NotebookAid T02 Bridge Test",
  "version": "0.2.4",
  "description": "Native Messaging lifecycle test for the NotebookAid T02 preview.",
  "author": "Jin Lu",
  "browser_specific_settings": {
    "gecko": {
      "id": "notebookaid-t02@zub-systems.de",
      "strict_min_version": "157.0"
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "icons": {
    "32": "icons/notebookaid-32.png",
    "48": "icons/notebookaid-48.png",
    "64": "icons/notebookaid-64.png",
    "128": "icons/notebookaid-128.png"
  },
  "browser_action": {
    "default_title": "NotebookAid T02",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/notebookaid-16.png",
      "32": "icons/notebookaid-32.png",
      "64": "icons/notebookaid-64.png"
    }
  }
}
