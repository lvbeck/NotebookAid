{
  "manifest_version": 2,
  "name": "NotebookAid",
  "version": "0.15.13",
  "description": "Browse local notebooks and open notes in NotebookAid.",
  "author": "Jin Lu",
  "browser_specific_settings": {
    "gecko": {
      "id": "notebookaid@zub-systems.de",
      "strict_min_version": "157.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "messagesRead",
    "messagesTagsList"
  ],
  "icons": {
    "32": "icons/notebookaid-32.png",
    "48": "icons/notebookaid-48.png",
    "64": "icons/notebookaid-64.png",
    "128": "icons/notebookaid-128.png"
  },
  "browser_action": {
    "default_title": "NotebookAid",
    "default_icon": {
      "16": "icons/notebookaid-16.png",
      "32": "icons/notebookaid-32.png",
      "64": "icons/notebookaid-64.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
}
